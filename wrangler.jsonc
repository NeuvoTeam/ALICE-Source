{
  "name": "clinical-ai-backend",
  "compatibility_date": "2026-06-03",
  "main": "backend/CloudFlare.js",
  "observability": { "enabled": true },
  // GROQ_RESPONSE_FORMAT selects how the JSON contract is requested:
  //   "off" (default) - prompt-only; measured most reliable on gpt-oss-20b;
  //   "json_object"   - syntax-only JSON mode (answers parsed, but the model
  //                     stopped after `homework` in 4 of 8 runs);
  //   "schema"        - strict json_schema (Groq validates after generation and
  //                     returned 400 "failed_generation" in ~40% of runs).
  // The strict schemas are always used for *validation* regardless of the mode.
  //
  // GROQ_MAX_TOKENS is deliberately NOT set.
  // Measured on the on-demand 8,000 TPM tier: the limiter reserves the *prompt*
  // tokens (a 20,000-char note reports "Requested 4776"), not max_completion_tokens.
  // Capping the completion would therefore not prevent a 429 (the analyze +
  // practice-package pair sends the notes twice) and would instead risk cutting
  // the JSON off mid-object (`AI_TRUNCATED`). The ceiling belongs on the input:
  // see SESSION_NOTES_MAX_CHARS / SESSION_NOTES_WARN_CHARS in lib/clinical-ai-api.ts.
  "vars": {
    "GROQ_MODEL": "openai/gpt-oss-120b",
    "ALLOWED_ORIGINS": "http://localhost:3000",
    // Origin the signed client links point at (`/homework/:id`, `/practice/:id`).
    // Falls back to the first ALLOWED_ORIGINS entry when unset.
    "PUBLIC_APP_URL": "http://localhost:3000"
    // REVIEW_QUEUE_CURSOR_SECRET is a secret (set via `npx wrangler secret put REVIEW_QUEUE_CURSOR_SECRET`
    // or in .dev.vars locally). Dedicated HMAC-SHA256 key (minimum 16 characters) for signing review queue
    // pagination cursors. The endpoint (GET /tasks/submissions) fails closed (HTTP 503 CURSOR_SECRET_UNCONFIGURED)
    // and is completely unavailable until this secret is configured. Never falls back to a literal or cross-purpose key.
  }
}